<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<style>
  :root {
    --bubble-hue: {{ bubble_hue }};
    --avatar-hue: {{ avatar_hue }};
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .phone {
    width: {{ device_width }}px;
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .theme-light { background: #f4f4f5; color: #111114; }
  .theme-dark { background: #14141a; color: #f1f1f3; }

  .header {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(127,127,127,0.18);
  }
  .theme-dark .header { background: #1c1c24; }
  .theme-light .header { background: #ffffff; }

  .avatar {
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: hsl(var(--avatar-hue) 55% 45%);
    color: white; font-weight: 600; font-size: 15px; flex-shrink: 0;
  }
  .header-text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .header-name { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .header-sub { font-size: 11.5px; opacity: 0.6; font-family: ui-monospace, monospace; }
  .badge {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 10px; padding: 1px 6px; border-radius: 999px;
    background: hsla(var(--bubble-hue), 50%, 45%, 0.18); color: hsl(var(--bubble-hue) 60% 40%);
    margin-left: 6px; font-weight: 600;
  }
  .theme-dark .badge { color: hsl(var(--bubble-hue) 70% 70%); }

  .body { flex: 1; padding: 18px 12px; display: flex; flex-direction: column; gap: 8px; }

  .forwarded-tag {
    display: flex; align-items: center; gap: 4px;
    font-size: 11px; opacity: 0.55; font-style: italic; margin: 0 4px 2px;
  }

  .row { display: flex; }
  .row.in { justify-content: flex-start; }
  .row.out { justify-content: flex-end; }

  .bubble {
    max-width: 78%;
    padding: 9px 12px 18px;
    border-radius: 16px;
    position: relative;
    font-size: 14.5px;
    line-height: 1.42;
    word-wrap: break-word;
  }
  .bubble .ts {
    position: absolute; right: 10px; bottom: 4px;
    font-size: 10px; opacity: 0.55;
  }

  .row.in .bubble { border-bottom-left-radius: 4px; }
  .row.out .bubble { border-bottom-right-radius: 4px; }

  .theme-light .row.in .bubble { background: #ffffff; color: #111114; box-shadow: 0 1px 1px rgba(0,0,0,0.08); }
  .theme-dark .row.in .bubble { background: #232330; color: #f1f1f3; }

  .row.out .bubble { background: hsl(var(--bubble-hue) 45% 42%); color: white; }

  .qr-wrap { margin-top: 8px; padding: 8px; background: white; border-radius: 10px; display: inline-block; }
  .qr-wrap img { display: block; width: 120px; height: 120px; }

  .platform-instagram .avatar { box-shadow: 0 0 0 2px hsl(var(--avatar-hue) 70% 55%); }

  .email-body { padding: 20px 22px; }
  .email-subject { font-size: 18px; font-weight: 700; margin-bottom: 10px; }
  .email-meta { font-size: 12.5px; opacity: 0.65; margin-bottom: 2px; }
  .email-meta b { opacity: 1; font-weight: 600; }
  .email-content { margin-top: 16px; font-size: 14px; line-height: 1.6; white-space: pre-wrap; }
  .email-qr { margin-top: 16px; }
</style>
</head>
<body>
  <div class="phone platform-{{ platform }} theme-{{ theme }}">
    {% if platform == 'email' %}
      <div class="header">
        <div class="avatar">{{ avatar_label }}</div>
        <div class="header-text">
          <span class="header-name">Inbox</span>
        </div>
      </div>
      <div class="email-body">
        <div class="email-subject">{{ email_subject }}</div>
        <div class="email-meta">From: <b>{{ contact_name or contact_email }}</b> &lt;{{ contact_email }}&gt;</div>
        <div class="email-meta">To: me</div>
        <div class="email-content">{{ message_text }}</div>
        {% if embed_qr %}
        <div class="qr-wrap email-qr"><img src="{{ qr_data_uri }}" /></div>
        {% endif %}
      </div>
    {% else %}
      <div class="header">
        <div class="avatar">{{ avatar_label }}</div>
        <div class="header-text">
          <span class="header-name">
            {% if is_unknown_number %}{{ contact_phone }}{% else %}{{ contact_name }}{% endif %}
            {% if is_business %}<span class="badge">Business</span>{% endif %}
          </span>
          <span class="header-sub">
            {% if is_unknown_number %}Unknown number{% else %}{{ contact_phone }}{% endif %}
          </span>
        </div>
      </div>
      <div class="body">
        {% if is_forwarded %}<div class="forwarded-tag">&#8618; Forwarded</div>{% endif %}
        <div class="row in">
          <div class="bubble">
            {{ message_text }}
            {% if embed_qr %}<div class="qr-wrap"><img src="{{ qr_data_uri }}" /></div>{% endif %}
            <span class="ts">{{ timestamp }}</span>
          </div>
        </div>
        {% if has_reply %}
        <div class="row out">
          <div class="bubble">{{ reply_text }}<span class="ts">{{ timestamp }}</span></div>
        </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</body>
</html>
